{
    "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2023",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
  "types": [
    "node"
],
   "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "resolveJsonModule": true
  },
  "include": ["src", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]

}